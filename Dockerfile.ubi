FROM node:24-bookworm AS ui
WORKDIR /src/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM golang:1.27.3-bookworm AS build
ARG GIT_COMMIT
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=ui /src/ui/dist ./ui/dist
RUN go build -o /mocn -ldflags "-s -w -X github.com/ellanetworks/mocn/version.GitCommit=${GIT_COMMIT}" ./cmd/mocn

FROM registry.access.redhat.com/ubi10/ubi-minimal

ARG VERSION
ARG RELEASE

LABEL name="ella-mocn" \
      maintainer="Ella Networks Inc." \
      vendor="Ella Networks Inc." \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="Ella MOCN, a multi-operator core network gateway that shares one radio network between several mobile operators." \
      description="Ella MOCN connects your neutral-host radio network to multiple mobile operators." \
      io.k8s.display-name="Ella MOCN" \
      io.k8s.description="Ella MOCN, a multi-operator core network gateway that shares one radio network between several mobile operators." \
      url="https://docs.ellanetworks.com/mocn/"

COPY LICENSE /licenses/
COPY mocn.yaml /mocn.yaml
COPY --from=build /mocn /usr/bin/mocn

ENTRYPOINT ["/usr/bin/mocn"]
CMD ["--config", "/mocn.yaml"]
